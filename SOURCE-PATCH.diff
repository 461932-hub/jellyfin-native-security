+    {
+        if (userId.Equals(Guid.Empty) || itemId.Equals(Guid.Empty) || !Enum.IsDefined(type)
+            || index is < 0 or > 999 || tag.Length is 0 or > 256
+            || deviceId.Length is 0 or > 128 || !ValidToken(token))
+        {
